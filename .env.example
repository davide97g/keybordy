# Copy to .env and fill in. .env is gitignored.
# Board base MAC, from: esptool --port /dev/cu.usbserial-0001 read-mac
ESP32_BASE_MAC=xx:xx:xx:xx:xx:xx
# Bench Wi-Fi for over-the-air updates (2.4 GHz). `just mp-secrets` turns these into
# firmware/libraries/KeybordyBench/src/bench_secrets.h, which is gitignored too.
ESP32_WIFI_SSID=your-network
ESP32_WIFI_PASS=your-password
# Password the board asks for before accepting an OTA upload.
ESP32_OTA_PASS=pick-something
